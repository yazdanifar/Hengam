{
  "name": "hengam",
  "version": "0.1.0",
  "description": "هنگام — Persian (Jalali) daily planner",
  "main": "out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "icon": "node scripts/make-icon.mjs",
    "holidays": "node --no-warnings scripts/fetch-holidays.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext .ts,.tsx",
    "verify": "npm run typecheck && npm run test:coverage",
    "build:mac": "npm run icon && npm run build && electron-builder --mac dmg --arm64",
    "build:win": "npm run icon && npm run build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "ir.hengam.app",
    "productName": "Hengam",
    "npmRebuild": false,
    "electronLanguages": ["fa"],
    "files": [
      "out/**/*",
      "build/icon-day.svg",
      "build/icon-tray.svg",
      "src/shared/data/holidays/**/*.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/vazirmatn/fonts/ttf/Vazirmatn-ExtraBold.ttf"
    ],
    "mac": {
      "identity": null,
      "icon": "build/icon.png",
      "extendInfo": { "CFBundleDevelopmentRegion": "fa" },
      "target": [{ "target": "dmg", "arch": ["arm64"] }]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Hengam",
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^13.0.3",
    "jalaali-js": "^1.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rrule": "^2.8.1",
    "vazirmatn": "^33.0.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.1",
    "electron": "^38.2.0",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "fast-check": "^3.22.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
